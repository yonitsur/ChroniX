# ChroniX Backend Configuration Example
# Primary Paid/High-Speed Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Free Tier Gemini Keys (Automatic Fallback):
# Used when daily paid quotas are reached, in 'free' mode, OR automatically when
# GEMINI_API_KEY runs out of billing credits, prepayment budget, or hits quota limits.
# Multiple free keys rotate round-robin to avoid single-key rate limits.
GEMINI_API_KEY_FREE=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_1=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_2=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_3=your_free_tier_gemini_key_here

# YouTube Data API v3 key for the event drawer's Videos tab (optional).
# Without it the tab shows a "Search on YouTube" link instead of embedded results.
# Default quota: 10,000 units/day = ~100 uncached searches. Results are saved on each event and
# cached 30 days in Supabase (table youtube_search_cache, see README).
GCLOUD_API_KEY=your_youtube_data_api_key_here
# Google Cloud Text-to-Speech API key (optional; 1M WaveNet chars/month free tier).
# Used for standard/guest podcast voices (especially Hebrew he-IL-Wavenet-D / he-IL-Wavenet-A).
# If omitted, falls back automatically to GCLOUD_API_KEY (if Cloud Text-to-Speech API is enabled on that GCP project),
# and then to Microsoft edge-tts.
GOOGLE_CLOUD_TTS_API_KEY=your_google_cloud_tts_api_key_here
GEMINI_API_KEY_FREE_4=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_5=your_free_tier_gemini_key_here

PORT=8000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
SUPABASE_ANON_KEY=your-supabase-anon-key
# Local access-token verification (no Supabase Auth round-trip per request). Legacy HS256 projects:
# Supabase -> Project Settings -> API -> JWT Secret. Projects on asymmetric signing keys need nothing:
# the public JWKS at <SUPABASE_URL>/auth/v1/.well-known/jwks.json is fetched and cached automatically.
# Tokens that can't be verified locally fall back to Supabase Auth (/auth/v1/user).
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# SUPABASE_JWT_LOCAL_VERIFY=true        # false = always ask Supabase Auth
# SUPABASE_JWT_AUDIENCE=authenticated
# SUPABASE_JWT_ISSUER=                  # default <SUPABASE_URL>/auth/v1; set if you use a custom auth domain
# SUPABASE_JWKS_URL=                    # default <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# SUPABASE_JWKS_CACHE_SECONDS=600
# AUTH_JWT_LEEWAY_SECONDS=30
# AUTH_TOKEN_CACHE_MAX_ENTRIES=20000    # Supabase Auth fallback cache (LRU)

# Client IP behind a proxy. On Render/Railway X-Forwarded-For is trusted automatically; the client is
# the entry TRUSTED_PROXY_HOPS from the right. Set LOG_FORWARDED_HEADERS_ONCE=true once to log the raw
# chain and confirm it. Never set uvicorn's FORWARDED_ALLOW_IPS to "*".
# TRUST_PROXY_HEADERS=                  # 1 / 0 to force on / off
# TRUSTED_PROXY_HOPS=1
# TRUSTED_CLIENT_IP_HEADER=             # e.g. CF-Connecting-IP, only if an edge you control overwrites it
# TRUST_X_REAL_IP=false
# LOG_FORWARDED_HEADERS_ONCE=false
# GUEST_IPV6_56_MULTIPLIER=4            # IPv6 /56 ceiling = this x the per-IP (/64) ceiling; 0 disables

# Own-key (BYOK) callers get unlimited sizes / 4x rate limits only after the key served a Gemini call.
# BYOK_VERIFIED_TTL_SECONDS=86400
# Free image engine (HF / Pollinations, 0 credits): daily caps per user/guest and per IP; admins exempt.
# FREE_IMAGE_DAILY_LIMIT=20
# FREE_IMAGE_IP_DAILY_LIMIT=100
# FREE_IMAGE_RATE_LIMIT_PER_MINUTE=10
# Uncached YouTube searches per day, site-wide (each costs 100 of 10,000 daily API units). 0 = no budget.
# YOUTUBE_DAILY_SEARCH_BUDGET=90

# Admin & Quota Configuration
ADMIN_EMAILS=admin@example.com
# Optional: existing auth user id (uuid, normally an admin) that owns curated Library seeds and the
# Library rows kept after a user deletes their account. Unset = those rows stay unowned (admin-only).
# SYSTEM_OWNER_USER_ID=00000000-0000-0000-0000-000000000000
# API key policy mode. One of:
#   unlimited - everyone uses the paid key with no credit limits (falls back to free keys if billing/quota runs out)
#   limited   - (default if unset) paid key up to the quota below, then falls back to free keys
#   free      - non-admins always use the free key; the paid key is never spent
# Admins always get the paid key with automatic free-key fallback if billing budget is exhausted.
# ONE shared daily AI credit bank per role covers every AI operation using weighted integer credits:
#   - Standard text/voice AI actions & light uploads (<=5 photos or <=10 PDF pages): 1 credit
#   - Medium uploads (6-20 photos, 11-25 PDF pages, >15k chars, or Chat file attachment): 2 credits
#   - Heavy document uploads (26+ PDF pages or heavy Chat file merges): 3 credits
#   - Gemini premium image generation: 6 credits (free image generator = 0 credits)
#   - Gemini premium podcast audio (Highlights / <= 12 events): 10 credits (free voice engines = 0 credits)
#   - Gemini premium podcast audio (Full story, > 12 events): 20 credits
# UI copy shown to guests dynamically adapts to API_KEY_MODE and DAILY_PAID_PROMPTS.
API_KEY_MODE=limited
DAILY_PAID_PROMPTS=25
GUEST_API_KEY_MODE=limited
GUEST_DAILY_PAID_PROMPTS=10
CREDIT_COST_TEXT=1
CREDIT_COST_UPLOAD_MEDIUM=2
CREDIT_COST_UPLOAD_HEAVY=3
CREDIT_COST_GEMINI_IMAGE=6
CREDIT_COST_GEMINI_AUDIO=10
CREDIT_COST_GEMINI_AUDIO_FULL=20

# Monthly Google Search Grounding query guardrail on the server's paid GEMINI_API_KEY:
# Gemini 3+ paid keys include 5,000 free search queries/month, then bill $14 / 1,000 queries.
# Default 4750 stays safely inside the free tier and routes excess grounding calls to GEMINI_API_KEY_FREE*
# (or skips grounding if no separate free key is configured). Set to -1 for uncapped paid grounding.
GOOGLE_SEARCH_GROUNDING_MONTHLY_QUERY_LIMIT=4750

# Optional Global Community AI Pool Guardrail:
# Caps total daily / monthly paid-key AI prompts across ALL non-admin visitors combined.
# When reached, the server automatically falls back to rotating free keys (GEMINI_API_KEY_FREE*).
# Set to -1 or 0 (default) for no global pool cap.
DAILY_COMMUNITY_PAID_LIMIT=-1
MONTHLY_COMMUNITY_PAID_LIMIT=-1

# Hidden real-cost backstop (USD of actual paid-key spend per UTC day, metered from token usage).
# Credits stay the user-facing price; these caps only catch abuse and runaway requests.
# Normal use of the daily credits costs far less (25 credits ~ $0.125), so honest users never see them.
# When reached, text features keep working on the free keys and premium images/audio are declined.
# Admins and personal-key (BYOK) users are never capped. Set any value to 0 to disable it.
DAILY_USD_CAP_REGISTERED=0.50
DAILY_USD_CAP_GUEST=0.20
# Per-IP guest backstop (defaults to 5x DAILY_USD_CAP_GUEST, so a classroom behind one NAT isn't
# capped as one guest). Same idea for daily credits: GUEST_IP_DAILY_PAID_PROMPTS defaults to 5x
# GUEST_DAILY_PAID_PROMPTS (50 with the default 10); set either lower/higher to tune.
# GUEST_IP_DAILY_USD_CAP=1.00
# GUEST_IP_DAILY_PAID_PROMPTS=50
# System-wide circuit breaker across ALL non-admin users of the paid key.
DAILY_COMMUNITY_USD_LIMIT=5.00

# Per-tier AI size ceilings (keep a single action close to its fixed credit price).
# Admins and BYOK users have no ceilings. Set to 0 to remove a ceiling.
# GUEST_MAX_PROMPT_EVENTS=50
# REGISTERED_MAX_PROMPT_EVENTS=50
# GUEST_MAX_FILE_EVENTS=60
# REGISTERED_MAX_FILE_EVENTS=120
# GUEST_MAX_REFINE_NEW_EVENTS=25
# REGISTERED_MAX_REFINE_NEW_EVENTS=40
# GUEST_MAX_REFINE_CONTEXT_CHARS=80000
# REGISTERED_MAX_REFINE_CONTEXT_CHARS=200000
# GUEST_PODCAST_MAX_EVENTS=25
# REGISTERED_PODCAST_MAX_EVENTS=25

# Optional Non-Commercial Voluntary Donation URL (e.g., Ko-fi, Buy Me a Coffee, GitHub Sponsors):
# Supports the shared Community AI Pool for everyone (100% voluntary, no personal credits or paywalls).
COMMUNITY_DONATION_URL=https://ko-fi.com/chronixai
KOFI_VERIFICATION_TOKEN=your_kofi_verification_token_here
# Default timeline creation mode: 'fast' or 'verified'
DEFAULT_TIMELINE_MODE=fast

# Rate Limiting: maximum timeline generation / refinement / chat requests per minute per user/IP.
# Default is 10. Set to 0 to disable rate limiting completely.
TIMELINE_RATE_LIMIT_PER_MINUTE=10
# Guests are rate-limited per guest session; all guests on one IP share a ceiling of this multiple
# of the per-guest limit (default 5; 0 disables the IP ceiling).
# GUEST_RATE_LIMIT_IP_MULTIPLIER=5
# Concurrent background AI jobs: per user/guest session (default 2), and across all users on one IP (default 12).
# MAX_CONCURRENT_JOBS_PER_USER=2
# MAX_CONCURRENT_JOBS_PER_IP=12
# Finished AI results kept in memory until the client polls them (approx. bytes, default 64 MB).
# AI_JOBS_MAX_FINISHED_BYTES=67108864

# CORS (REQUIRED in production): comma-separated frontend origins. In production (APP_ENV=production
# or on Render) an unset CORS_ORIGINS refuses all cross-origin browser calls; outside production it
# defaults to "*". CORS_ORIGIN_REGEX optionally allows e.g. preview deployments.
# CORS_ORIGINS=https://chronix.example.com,https://www.chronix.example.com
# CORS_ORIGIN_REGEX=https://.*-yourteam\.vercel\.app
# ALLOW_ANY_CORS_ORIGIN=false   # explicit escape hatch: allow any origin in production
# APP_ENV=production            # overrides the RENDER-based production detection

# Quota store (ai_usage in Supabase). In production a store failure FAILS CLOSED: paid-key text runs in
# basic mode (503 if no free key), premium images/audio return 503, server-paid counters are skipped,
# and nothing is written to the ephemeral local file. Outside production it falls back to the local file.
# QUOTA_LOCAL_FALLBACK=           # true = always allow the local-file fallback, false = never; unset = dev only
# QUOTA_STORE_COOLDOWN_SECONDS=20 # circuit-breaker cooldown after a store failure (then one half-open probe)
# COMMUNITY_STATUS_CACHE_SECONDS=45 # in-process cache of the community ledger / pool status (0 = off)
# Secret salts (S-11). Unset in production, they are derived from SUPABASE_SERVICE_ROLE_KEY (not public);
# set long random values, e.g. `python -c "import secrets; print(secrets.token_hex(32))"`.
# QUOTA_IP_HASH_SALT=             # salts the hashed guest-IP quota identifiers

# Health check: /api/health returns 503 when the event loop lags more than this (0 disables).
# HEALTH_MAX_LOOP_LAG_SECONDS=5
# Shutdown: time budget for refunding still-pending AI jobs.
# SHUTDOWN_REFUND_BUDGET_SECONDS=5
# Saves (POST /api/timelines) per minute per user/IP; admins exempt, own-key users get 4x. Default 120.
# TIMELINE_SAVE_RATE_LIMIT_PER_MINUTE=120
# Pixel-bomb safety caps (apply to everyone, incl. admins and own-key users). Defaults shown.
# MAX_INLINE_IMAGE_PIXELS=12000000       # inline data: images, AI image output, photo-import AI thumbnails
# MAX_IMAGE_SIDE=8192
# MAX_HOSTED_PHOTO_PIXELS=24000000       # hosted photo uploads (re-encoded to 2048 px)
# MAX_HOSTED_PHOTO_SIDE=12000
# PIL_MAX_IMAGE_PIXELS=40000000          # process-wide Pillow backstop
# TIMELINE_MAX_INLINE_IMAGES_PER_ARTICLE=24
# TIMELINE_MAX_INLINE_IMAGES=400
HF_API_TOKEN=your_huggingface_api_token_here

# Optional Wikimedia Personal API Token (OAuth 2.0 Owner-Only access token):
# Raises Wikimedia global API quota from 500 req/hr (anonymous shared IP) to 5,000 req/hr
# and isolates ChroniX from shared cloud-IP throttling. Create free at:
# https://meta.wikimedia.org/wiki/Special:OAuthConsumerRegistration (OAuth 2.0, owner-only)
WIKIMEDIA_ACCESS_TOKEN=your_wikimedia_personal_api_token_here

# Optional Memory Tuning for Linux Servers:
# MALLOC_MMAP_THRESHOLD_=131072
# MALLOC_ARENA_MAX=2
# Story Studio photo import - hosted photos (Supabase Storage, public bucket with unguessable keys)
# PHOTO_STORAGE_BUCKET=timeline-photos
# PHOTO_STORAGE_BACKEND=local          # force local data/photos/ (dev)
# REGISTERED_HOSTED_PHOTOS=2000         # per registered / own-key user; admins unlimited; guests inline only
# PHOTO_STORAGE_SALT=some-random-string # salts owner folder names (dev default: SUPABASE_URL; production: derived secret)

# Latency & scale knobs (Batch 5A, all optional; see DEPLOYMENT_STEPS.md for the full list)
# GEMINI_FREE_RPM_PER_KEY_MODEL=9      # pace free keys under their RPM instead of hitting 429s (0 = off)
# ADJUDICATOR_MODEL=                   # cheap model for the Wikipedia adjudicator (default: a flash-lite in GEMINI_MODEL, else gemini-3.6-flash)
# ADJUDICATOR_TIMEOUT_SEC=5.5
# WIKI_GIF_SEARCH=auto                 # auto | always | off
# NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org   # or a self-hosted / commercial Nominatim-compatible geocoder
# REVERSE_GEOCODE_REQUEST_DEADLINE_SEC=15
# FREE_IMAGE_HEDGE_AFTER_SEC=8
# ENRICHMENT_CACHE_ENABLED=true        # Postgres cache (migration 003); a missing table just disables it
BOOK_IMPORT_ENABLED=true
BOOK_IMPORT_GEMINI_API_KEY=your_gemini_api_key_for_book_import_here