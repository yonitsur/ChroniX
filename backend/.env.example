# ChroniX Backend Configuration Example
# Primary Paid/High-Speed Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Free Tier Gemini Keys (Automatic Fallback):
# Used when daily paid quotas are reached, in 'free' mode, OR automatically when
# GEMINI_API_KEY runs out of billing credits, prepayment budget, or hits quota limits.
# Multiple free keys rotate round-robin to avoid single-key rate limits.
GEMINI_API_KEY_FREE=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_1=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_2=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_3=your_free_tier_gemini_key_here

# YouTube Data API v3 key for the event drawer's Videos tab (optional).
# Without it the tab shows a "Search on YouTube" link instead of embedded results.
# Default quota: 10,000 units/day = ~100 uncached searches. Results are saved on each event and
# cached 30 days in Supabase (table youtube_search_cache, see README).
GCLOUD_API_KEY=your_youtube_data_api_key_here
# Google Cloud Text-to-Speech API key (optional; 1M WaveNet chars/month free tier).
# Used for standard/guest podcast voices (especially Hebrew he-IL-Wavenet-D / he-IL-Wavenet-A).
# If omitted, falls back automatically to GCLOUD_API_KEY (if Cloud Text-to-Speech API is enabled on that GCP project),
# and then to Microsoft edge-tts.
GOOGLE_CLOUD_TTS_API_KEY=your_google_cloud_tts_api_key_here
GEMINI_API_KEY_FREE_4=your_free_tier_gemini_key_here
GEMINI_API_KEY_FREE_5=your_free_tier_gemini_key_here

PORT=8000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret
SUPABASE_ANON_KEY=your-supabase-anon-key

# Admin & Quota Configuration
ADMIN_EMAILS=admin@example.com
# API key policy mode. One of:
#   unlimited - everyone uses the paid key with no limits (falls back to free keys if billing/quota runs out)
#   limited   - paid key up to the quota below, then falls back to free keys (also falls back if billing runs out)
#   free      - non-admins always use the free key; the paid key is never spent
# Admins always get the paid key with automatic free-key fallback if billing budget is exhausted.
# ONE shared daily AI credit bank per role covers every AI operation using weighted integer credits:
#   - Standard text/voice AI actions & light uploads (<=5 photos or <=10 PDF pages): 1 credit
#   - Medium uploads (6-20 photos, 11-25 PDF pages, >15k chars, or Chat file attachment): 2 credits
#   - Heavy document uploads (26+ PDF pages or heavy Chat file merges): 3 credits
#   - Gemini premium image generation: 6 credits (free image generator = 0 credits)
#   - Gemini premium podcast audio (Highlights / <= 12 events): 10 credits (free voice engines = 0 credits)
#   - Gemini premium podcast audio (Full story, > 12 events): 20 credits
# UI copy shown to guests dynamically adapts to API_KEY_MODE and DAILY_PAID_PROMPTS.
API_KEY_MODE=limited
DAILY_PAID_PROMPTS=25
GUEST_API_KEY_MODE=limited
GUEST_DAILY_PAID_PROMPTS=10
CREDIT_COST_TEXT=1
CREDIT_COST_UPLOAD_MEDIUM=2
CREDIT_COST_UPLOAD_HEAVY=3
CREDIT_COST_GEMINI_IMAGE=6
CREDIT_COST_GEMINI_AUDIO=10
CREDIT_COST_GEMINI_AUDIO_FULL=20

# Monthly Google Search Grounding query guardrail on the server's paid GEMINI_API_KEY:
# Gemini 3+ paid keys include 5,000 free search queries/month, then bill $14 / 1,000 queries.
# Default 4750 stays safely inside the free tier and routes excess grounding calls to GEMINI_API_KEY_FREE*
# (or skips grounding if no separate free key is configured). Set to -1 for uncapped paid grounding.
GOOGLE_SEARCH_GROUNDING_MONTHLY_QUERY_LIMIT=4750

# Optional Global Community AI Pool Guardrail:
# Caps total daily / monthly paid-key AI prompts across ALL non-admin visitors combined.
# When reached, the server automatically falls back to rotating free keys (GEMINI_API_KEY_FREE*).
# Set to -1 or 0 (default) for no global pool cap.
DAILY_COMMUNITY_PAID_LIMIT=-1
MONTHLY_COMMUNITY_PAID_LIMIT=-1

# Optional Non-Commercial Voluntary Donation URL (e.g., Ko-fi, Buy Me a Coffee, GitHub Sponsors):
# Supports the shared Community AI Pool for everyone (100% voluntary, no personal credits or paywalls).
COMMUNITY_DONATION_URL=https://ko-fi.com/chronixai
KOFI_VERIFICATION_TOKEN=your_kofi_verification_token_here
# Default timeline creation mode: 'fast' or 'verified'
DEFAULT_TIMELINE_MODE=fast

# Rate Limiting: maximum timeline generation / refinement / chat requests per minute per user/IP.
# Default is 10. Set to 0 to disable rate limiting completely.
TIMELINE_RATE_LIMIT_PER_MINUTE=10
HF_API_TOKEN=your_huggingface_api_token_here

# Optional Memory Tuning for Linux Servers:
# MALLOC_MMAP_THRESHOLD_=131072
# MALLOC_ARENA_MAX=2