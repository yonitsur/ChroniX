VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_API_URL=https://your-render-backend-name.onrender.com


# Default timeline creation mode: 'fast' (default, no web search) or 'verified' (Google search grounding)
VITE_DEFAULT_TIMELINE_MODE=fast

# Map Basemap Tile Provider: 'esri' | 'osm'
VITE_MAP_TILE_PROVIDER=esri
VITE_GOOGLE_CLIENT_ID=your-google-client-id
# Optional: Default frontend quota policy settings (matched with backend API_KEY_MODE and limits)
VITE_API_KEY_MODE=limited
VITE_DAILY_PAID_PROMPTS=10
VITE_GUEST_API_KEY_MODE=limited
VITE_GUEST_DAILY_PAID_PROMPTS=3

# Day Mode Background: 'topo' (Topography) | 'constellations'
VITE_DAY_BACKGROUND=constellations

# Feature Flags
# Interactive coach-mark guide / new user tour: 'false' (disabled) | 'true' (enabled)
VITE_ENABLE_INTERACTIVE_GUIDE=false



